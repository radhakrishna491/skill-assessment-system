generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  STUDENT
  TRAINER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  student Student?
  trainer Trainer?
}

model Student {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch     String?
  year       Int?
  resumeText String? 
  
  skills        StudentSkill[]
  assessments   Assessment[]
  allocations   TeamAllocation[]
  projects      Project[]
  certifications Certification[]
  skillGaps     SkillGap[]
}

// NEW: Added source tracking
model StudentSkill {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillName     String
  domain        String
  selfLevel     Int      @default(1) // 1-5
  verifiedLevel Int?     
  source        String   @default("self") // "self", "resume", "verified"
}

model Project {
  id          String  @id @default(cuid())
  studentId   String
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String
  technologies String
}

model Certification {
  id          String  @id @default(cuid())
  studentId   String
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  issuer      String
}

model Trainer {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expertise String   
  bio       String?
  assessments Assessment[]
}

model Team {
  id             String   @id @default(cuid())
  name           String
  domain         String
  requiredSkills String   // JSON string with weights (e.g. [{"skill":"Python", "weight":5}])
  description    String?
  allocations    TeamAllocation[]
}

model TeamAllocation {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  score       Float
  reasons     String   
  status      String   @default("recommended") 
  createdAt   DateTime @default(now())
}

model Assessment {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  trainerId  String
  trainer    Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  domain     String
  scores     String   
  feedback   String
  strengths  String   
  weaknesses String   
  createdAt  DateTime @default(now())
}

// NEW: Skill Gap Analysis
model SkillGap {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetTeamId   String
  missingSkill   String
  severity       String   // "low", "medium", "critical"
  learningAction String
  createdAt      DateTime @default(now())
}